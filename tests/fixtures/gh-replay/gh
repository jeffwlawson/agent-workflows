// The refs whose name starts with the one given, in the documented shape: an
// array of `{ref, object: {sha}}`, empty where none matches. The prefix is
// matched as a string, so `heads/agent/prd-17-` does not match
// `heads/agent/prd-171-…`.
const matchingRefs = /^repos\/[^/]+\/[^/]+\/git\/matching-refs\/(.+)$/.exec(endpoint);


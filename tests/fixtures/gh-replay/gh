}

// An issue's blockers: the REST array of issues, `state` lower-case. One
// array for every issue, or one per issue where the scenario keys them: the
// PRD preflight reads the parent's and then each sub-issue's.
const blockedBy = /\/issues\/([0-9]+)\/dependencies\/blocked_by$/.exec(endpoint);

if (blockedBy !== null) {
  const blockers = fixture("GH_REPLAY_BLOCKED_BY", []);

  emit(Array.isArray(blockers) ? blockers : (blockers[blockedBy[1]] ?? []));
  process.exit(0);

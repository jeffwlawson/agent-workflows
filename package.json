{
  "name": "@jeffwlawson/agent-workflows",
  "version": "0.1.4",
  "description": "Runners for a GitHub Actions agent loop: implement, implement-prd, review, fix, update-branch",
  "type": "module",
  "license": "MIT",
  "author": "jeffwlawson",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "agent-workflows": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node dist/scripts/copy-assets.js",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "0.12.0"
  },
  "devDependencies": {
    "@standard-schema/spec": "^1.0.0",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1"
  }
}

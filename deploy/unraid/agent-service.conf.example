# agent-service.conf: the settings of one deployment of the service on Unraid.
#
# Copy this file to agent-service.conf beside the scripts, on each machine they
# run on (Unraid's /boot/config/agent-service/, and beside the box's copies),
# and change what differs from the defaults. Every script reads it as shell
# before its own defaults, so anything left out here keeps the default the
# script names. agent-service.conf is git-ignored: it holds your network's
# layout, not secrets. Secrets are typed at prompts or generated, never set here.

# --- Unraid -------------------------------------------------------------------

# The time zone the dispatcher's container logs in.
#TZ_NAME=UTC

# The box's network card, reserved for BOX_IP on agentnet. Only read when the VM
# does not exist yet, and then it replaces any card already reserved. Unset,
# install-unraid.sh keeps the card already reserved, or makes one up, and prints it.
#BOX_MAC=52:54:00:00:00:00

# The dispatcher's appdata, and the user its container runs as (Unraid's
# nobody:users).
#APPDATA=/mnt/user/appdata/agent-dispatcher
#CONTAINER_USER=99:100

# The Funnel port GitHub's webhooks arrive on.
#FUNNEL_PORT=10000

# --- agentnet, both machines --------------------------------------------------

# The private network between Unraid and the box: Unraid's address on it and
# the box's reserved one. Any private /24 not otherwise in use works.
#NET=agentnet
#BRIDGE=virbr-agent
#VM=agent-box
#HOST_IP=192.168.250.1
#BOX_IP=192.168.250.11
# upgrade.sh reaches the box at BOX_IP over ssh and has no default for it: set
# it here, uncommented, even where it is the address above.

# The doors: the dispatcher's webhook and token doors, the worker's job door.
#WEBHOOK_PORT=8790
#TOKEN_PORT=8791
#JOBS_PORT=8787

# --- Upgrades, run from Unraid -----------------------------------------------

# Where upgrade.sh downloads each release from: the repository the package is
# released from, as <owner>/<repo>. Unset, it reads the installed package's
# repository field, and refuses where that names no github.com repository.
#PACKAGE_SOURCE=<owner>/<repo>

# The package's name, which names the release's tarball. Unset, upgrade.sh takes
# the package the dispatcher's install (APPDATA/pkg) depends on.
#PACKAGE_NAME=@<scope>/agent-workflows

# The box's admin account, which upgrade.sh logs in as over ssh and which may
# sudo. No default: upgrade.sh refuses without it.
#BOX_SSH_USER=

# The private key for that login, where ssh's default one is not it. Host keys
# are kept in known_hosts beside this file, never under ~/.ssh.
#BOX_SSH_KEY=/boot/config/agent-service/box_key

# Where upgrade.sh stages the tarball on Unraid (/root is in memory there).
#STAGE_DIR=/root

# How long upgrade.sh waits, in minutes, for the worker to hold no job before
# it restarts it: the worker's queue is in memory, so a restart drops what it
# holds. 90 covers one job reaching its own time limit at the defaults, the
# longest being implement-prd's 65 (its other jobs' 35 and the agent's 30),
# with room for the job to wind down. Raise it with AGENT_TIMEOUT_MINUTES. Past
# it, upgrade.sh restarts nothing and stops; --now restarts without waiting.
#IDLE_WAIT_MINUTES=90

# The dispatcher's container, which upgrade.sh asks the worker's held door
# from, with the WORKER_SECRET set in it.
#CONTAINER=agent-dispatcher

# --- The box ------------------------------------------------------------------

# Node (from nodejs.org, linux-x64 only) and the agent's CLI the worker installs.
#NODE_VERSION=24.21.0
#CLAUDE_CODE_VERSION=2.1.290

# tinyproxy's port on the box's loopback.
#PROXY_PORT=3128

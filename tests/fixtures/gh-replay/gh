#!/usr/bin/env node
/*
 * A replay of `gh api`, standing in for the real binary so that
 * `tests/review-ci-wait.test.ts` can *execute* the review workflow's CI
 * collection instead of pattern-matching its text.
 *
 * Every behaviour below was recorded from a real `gh` (2.100.0, 2026-09-19) and
 * is quoted where it is implemented. This file is a *replay*, not a model: an
 * invocation it holds no recording for exits 2 with a loud message rather than
 * guessing, because a stub that improvises is the thing that let
 * `--paginate --slurp --jq` — an invocation gh refuses outright — pass review,
 * the tests and CI for a whole release (#28).
 *
 * The one rule that has to stay true of the real binary is the `--slurp`
 * refusal below, and it is not trusted to this file: `review-ci-wait.test.ts`
 * re-verifies it against whatever `gh` is installed before using the replay.
 *
 * Endpoints recorded:
 *   repos/{owner}/{repo}/commits/{sha}/check-runs  — pages from GH_REPLAY_PAGES
 *   repos/{owner}/{repo}/commits/{sha}/status      — pages from GH_REPLAY_STATUS_PAGES
 *   repos/{owner}/{repo}/actions/runs?…            : runs from GH_REPLAY_RUNS_BY_CALL
 *   repos/{owner}/{repo}/actions/runs/{id}         —  "     "    "
 *
 *   graphql                                        — the issue from GH_REPLAY_ISSUE, or
 *                                                    a pull request's review threads
 *                                                    from GH_REPLAY_THREADS
 *   repos/{owner}/{repo}/issues/{n}/dependencies/blocked_by
 *                                                  — blockers from GH_REPLAY_BLOCKED_BY
 *   repos/{owner}/{repo}/git/matching-refs/{ref}   : the branches from GH_REPLAY_REFS
 *   repos/{owner}/{repo}                           — the repository from GH_REPLAY_REPO
 *   repos/{owner}/{repo}/compare/{base}...{head}   : the comparison from GH_REPLAY_COMPARE
 *   repos/{owner}/{repo}/actions/policies?…        : the list, from GH_REPLAY_POLICIES,
 *                                                    in the list's own shape (below)
 *   repos/{owner}/{repo}/actions/policies/{id}     : one policy in full, from the same
 *   --method POST|PUT repos/{owner}/{repo}/actions/policies[/{id}]
 *                                                  : logged to GH_REPLAY_LOG, exit 0
 *   -X DELETE repos/{owner}/{repo}/git/refs/heads/{branch}
 *                                                  — logged to GH_REPLAY_LOG, exit 0
 *
 * Subcommands recorded:
 *   run view {id} --log-failed                     — the log is unavailable
 *   repo view --json visibility --jq .visibility   : GH_REPLAY_VISIBILITY, bare
 *   pr list --state open|all [--head {branch}] [--base {branch}] --json {fields}
 *                                                  — pull requests from GH_REPLAY_PULLS
 *   pr view {n} --json {fields}                    —  "     "    "
 *   issue edit | issue comment                     — logged to GH_REPLAY_LOG, exit 0
 *   pr ready | pr merge | pr create | pr edit | pr comment
 *                                                  : logged to GH_REPLAY_LOG, exit 0
 *                                                    (pr merge exits 1 under GH_REPLAY_MERGE_FAILURE)
 *
 * Everything after `run view` serves `tests/implement-prd-preflight.test.ts`.
 * Their *shapes* are the documented ones — a GraphQL `{"data":…}` envelope,
 * the REST array and object, `--json` printing exactly the fields asked for,
 * and `pr create` printing the new pull request's URL last — and what is
 * re-verified against the real binary there is that gh accepts the flags and
 * field names the steps compose.
 *
 * Environment:
 *   GH_REPLAY_PAGES       path to a JSON array of page bodies, in page order
 *   GH_REPLAY_STATUS_PAGES  path to a JSON array of combined-status page bodies
 *   GH_REPLAY_STATUS_FAILURE  `403` or `unreachable`: how the status call fails
 *   GH_REPLAY_FAILURE     `403` or `unreachable`: how the check-runs call fails
 *   GH_REPLAY_FAILURE_AT  1-based check-runs call to start failing at; default 1
 *   GH_REPLAY_COUNTER     path this process counts check-runs calls in
 *   GH_REPLAY_RUNS_BY_CALL  path to a JSON array of workflow-run lists, one per
 *                         call to the runs listing and the last repeating; default none
 *   GH_REPLAY_RUNS_COUNTER  path this process counts runs-listing calls in
 *   GH_REPLAY_RUNS_FAILURE  `403` or `unreachable`: how the runs listing fails
 *   GH_REPLAY_ISSUE       path to the `issue` node the graphql query returns
 *   GH_REPLAY_BLOCKED_BY  path to a JSON array of blocking issues, the same for every
 *                         issue, or to an object keyed by issue number holding
 *                         one such array each; default none
 *   GH_REPLAY_REFS        path to a JSON array of branch names, each `{name, sha}`;
 *                         default none
 *   GH_REPLAY_PULLS       path to a JSON array of pull requests, each carrying
 *                         a `state` of OPEN, CLOSED or MERGED; default none.
 *                         One carrying `headRefOids` answers `pr view` with the
 *                         next of them as its `headRefOid` on each call, and
 *                         keeps the last: a head GitHub moves after a push
 *   GH_REPLAY_VIEW_COUNTER  path this process counts `pr view` calls in
 *   GH_REPLAY_COMPARE     path to the comparison object; unset has no recording
 *   GH_REPLAY_COMPARE_FAILURE  set: the comparison cannot be read
 *   GH_REPLAY_REPO        path to the repository object; default `{}`
 *   GH_REPLAY_THREADS     path to a JSON array of review thread nodes; default none
 *   GH_REPLAY_VISIBILITY  what `repo view` answers, e.g. PUBLIC; unset has no recording
 *   GH_REPLAY_POLICIES    path to a JSON array of Actions policies, each in full
 *                         (`conditions` and `rules` included), a parent's as well
 *                         as the repository's; default none
 *   GH_REPLAY_POLICY_FAILURE  comma-separated policy ids whose detail cannot be read
 *   GH_REPLAY_CREATED     the number `pr create` answers with; default 300
 *   GH_REPLAY_MERGE_FAILURE  set: `pr merge` is logged, then refused
 *   GH_REPLAY_LABEL_FAILURE  set: `pr edit --add-label` is logged, then refused
 *   GH_REPLAY_LOG         path each tracker write is appended to, one JSON
 *                         argv per line
 */
import { execFileSync } from "node:child_process";
import { existsSync, readFileSync, writeFileSync } from "node:fs";

const argv = process.argv.slice(2);

const die = (message, code) => {
  process.stderr.write(`${message}\n`);
  process.exit(code);
};

/** An invocation with no recording. Exit 2, distinct from gh's own failures. */
const unrecorded = () => die(`gh-replay: no recording for \`gh ${argv.join(" ")}\``, 2);

/**
 * The workflow runs on the commit, as one list per call to the runs listing:
 * a run that appears partway through the review's CI wait is a list that
 * changes between polls (#221). Empty unless a scenario supplies some.
 */
const runSnapshots = () => {
  const file = process.env["GH_REPLAY_RUNS_BY_CALL"];
  const snapshots = file === undefined ? [] : JSON.parse(readFileSync(file, "utf8"));

  return snapshots.length === 0 ? [[]] : snapshots;
};

/** Every run any snapshot holds, for the by-id lookup. */
const runs = () => runSnapshots().flat();

/** The list this call to the runs listing sees, counted across processes. */
const runsThisCall = () => {
  const snapshots = runSnapshots();
  const file = process.env["GH_REPLAY_RUNS_COUNTER"];
  const n = file === undefined ? 1 : (existsSync(file) ? Number(readFileSync(file, "utf8")) : 0) + 1;

  if (file !== undefined) writeFileSync(file, String(n));
  return snapshots[Math.min(n, snapshots.length) - 1];
};

// `gh run view <id> --log-failed`, recorded for a run whose log cannot be had.
// That is the only recording here, and it is the case that matters: gh exits
// **1 with nothing on stdout**, which inside the step's redirected group is a
// failing pipeline, which under `bash -e` ends the step. Recorded 2026-09-19
// against gh 2.100.0, pointed at an unreachable host so no token was needed:
//
//   $ GH_HOST=localhost gh run view 12345 --log-failed -R acme/widgets
//   failed to get run: Get "https://localhost/api/v3/repos/acme/widgets/…":
//     dial tcp [::1]:443: connect: connection refused   ← stderr, exit 1
//
// A *successful* `--log-failed` is deliberately not replayed: its output is
// job/step/timestamp-prefixed log text that nothing here has recorded, and
// inventing it is exactly the improvisation this file exists to refuse.
if (argv[0] === "run") {
  if (argv[1] !== "view" || !argv.includes("--log-failed")) unrecorded();
  die(`failed to get run: Get "https://localhost/api/v3/repos/…/actions/runs/${argv[2]}": dial tcp [::1]:443: connect: connection refused`, 1);
}

/** A JSON file a scenario supplies, or `fallback` when it supplies none. */
const fixture = (name, fallback) => {
  const file = process.env[name];

  return file === undefined ? fallback : JSON.parse(readFileSync(file, "utf8"));
};

/** The flag's value, from anywhere in argv. */
const argOf = (...names) => {
  const i = argv.findIndex((arg) => names.includes(arg));
  return i < 0 ? undefined : argv[i + 1];
};

// Tracker writes. Nothing reads their output, so the replay's whole job is to
// say they happened: one line per call, which is what a scenario asserts on
// when the point is that a refusal did — or did not — touch the issue.
if (argv[0] === "issue" && (argv[1] === "edit" || argv[1] === "comment")) {
  const log = process.env["GH_REPLAY_LOG"];

  if (log !== undefined) writeFileSync(log, `${JSON.stringify(argv)}\n`, { flag: "a" });
  process.exit(0);
}

/** `--json`'s output, through `--jq` if one was passed. */
const printJson = (value) => {
  const filter = argOf("--jq", "-q");
  const json = JSON.stringify(value);

  if (filter === undefined) process.stdout.write(`${json}\n`);
  else process.stdout.write(execFileSync("jq", ["-r", filter], { input: json, encoding: "utf8" }));
};

// `gh repo view --json visibility --jq .visibility`, which prints the enum
// upper-case and bare (#219). The one filter `init` composes, so no `jq`.
if (argv[0] === "repo" && argv[1] === "view" && argOf("--json") === "visibility") {
  const visibility = process.env["GH_REPLAY_VISIBILITY"];

  if (visibility === undefined || argOf("--jq", "-q") !== ".visibility") unrecorded();
  process.stdout.write(`${visibility}\n`);
  process.exit(0);
}

// Actions policy writes: `init`'s create and update (#219). Logged with the
// body they sent, which `--input` names a file for.
if (argv[0] === "api" && argv[1] === "--method" && /\/actions\/policies(\/[0-9]+)?$/.test(argv[3] ?? "")) {
  const log = process.env["GH_REPLAY_LOG"];
  const input = argOf("--input");
  const body = input === undefined ? undefined : JSON.parse(readFileSync(input, "utf8"));

  if (log !== undefined) writeFileSync(log, `${JSON.stringify([...argv.slice(0, 4), body])}\n`, { flag: "a" });
  process.exit(0);
}

/** One pull request holding exactly the fields `--json` named. */
const only = (pull) => Object.fromEntries((argOf("--json") ?? "").split(",").map((field) => [field, pull[field]]));

// `gh pr list`, which queries open pull requests only under `--state open`,
// every state under `--state all`, and prints, per `--json`, an array of
// objects holding exactly the fields named. `--head` keeps the ones from that
// branch and `--base` the ones into it.
if (argv[0] === "pr" && argv[1] === "list") {
  const state = argOf("--state", "-s");

  if (argOf("--json") === undefined || (state !== "open" && state !== "all")) unrecorded();

  const head = argOf("--head", "-H");
  const base = argOf("--base", "-B");

  printJson(
    fixture("GH_REPLAY_PULLS", [])
      .filter(
        (pull) =>
          (state === "all" || pull.state === "OPEN") &&
          (head === undefined || pull.headRefName === head) &&
          (base === undefined || pull.baseRefName === base),
      )
      .map(only),
  );
  process.exit(0);
}

// `gh pr view <n> --json …`: one object rather than an array. A number the
// scenario never mentions has no recording.
if (argv[0] === "pr" && argv[1] === "view") {
  const pull = fixture("GH_REPLAY_PULLS", []).find((candidate) => String(candidate.number) === argv[2]);

  if (pull === undefined || argOf("--json") === undefined) unrecorded();

  // A head that moves between calls (#229), counted across processes the way
  // the check-runs calls are, since every invocation is its own process.
  const heads = pull.headRefOids;
  if (Array.isArray(heads) && heads.length > 0) {
    const file = process.env["GH_REPLAY_VIEW_COUNTER"];
    const n = file === undefined ? 1 : (existsSync(file) ? Number(readFileSync(file, "utf8")) : 0) + 1;

    if (file !== undefined) writeFileSync(file, String(n));
    printJson(only({ ...pull, headRefOid: heads[Math.min(n, heads.length) - 1] }));
    process.exit(0);
  }
  printJson(only(pull));
  process.exit(0);
}

// Pull request writes, logged like the tracker writes above. `pr create`
// prints the URL of the pull request it opened, last.
if (argv[0] === "pr" && ["ready", "merge", "create", "edit", "comment"].includes(argv[1])) {
  const log = process.env["GH_REPLAY_LOG"];

  if (log !== undefined) writeFileSync(log, `${JSON.stringify(argv)}\n`, { flag: "a" });
  if (argv[1] === "merge" && process.env["GH_REPLAY_MERGE_FAILURE"] !== undefined) {
    process.stderr.write("GraphQL: Required status check \"ci\" is expected. (mergePullRequest)\n");
    process.exit(1);
  }
  if (argv[1] === "edit" && argv.includes("--add-label") && process.env["GH_REPLAY_LABEL_FAILURE"] !== undefined) {
    process.stderr.write("HTTP 502: Bad Gateway\n");
    process.exit(1);
  }
  if (argv[1] === "create") {
    process.stdout.write(`https://github.com/acme/widgets/pull/${process.env["GH_REPLAY_CREATED"] ?? "300"}\n`);
  }
  process.exit(0);
}

// A branch deleted through the refs endpoint. A write, logged.
if (argv[0] === "api" && argv[1] === "-X" && argv[2] === "DELETE" && /\/git\/refs\/heads\//.test(argv[3] ?? "")) {
  const log = process.env["GH_REPLAY_LOG"];

  if (log !== undefined) writeFileSync(log, `${JSON.stringify(argv)}\n`, { flag: "a" });
  process.exit(0);
}

// A pull request's body rewritten through the REST endpoint: the chain's mark
// before it merges a slice PR (#209). A write, logged.
if (argv[0] === "api" && argv[1] === "-X" && argv[2] === "PATCH" && /\/pulls\/\d+$/.test(argv[3] ?? "")) {
  const log = process.env["GH_REPLAY_LOG"];

  if (log !== undefined) writeFileSync(log, `${JSON.stringify(argv)}\n`, { flag: "a" });
  process.exit(0);
}

if (argv[0] !== "api") unrecorded();

const endpoint = argv[1] ?? "";
const flags = argv.slice(2);
const has = (...names) => names.some((name) => flags.includes(name));
const valueOf = (...names) => {
  const i = flags.findIndex((flag) => names.includes(flag));
  return i < 0 ? undefined : flags[i + 1];
};

// Recorded, and the whole reason this file exists. gh rejects the combination
// at flag-parse time — before any request — with this line on stderr, a usage
// dump after it, and exit 1:
//
//   $ gh api repos/o/r/commits/abc/check-runs --paginate --slurp --jq '.'
//   the `--slurp` option is not supported with `--jq` or `--template`
if (has("--slurp") && has("--jq", "-q", "--template", "-t")) {
  die("the `--slurp` option is not supported with `--jq` or `--template`", 1);
}

const filter = valueOf("--jq", "-q");

// Two commits compared, in the documented shape: `status` is `ahead` where the
// head descends from the base, and `behind`, `diverged` or `identical`
// otherwise. A scenario that supplies no comparison has no recording.
if (/\/compare\/[^/]+\.\.\.[^/]+$/.test(endpoint)) {
  if (process.env["GH_REPLAY_COMPARE_FAILURE"] !== undefined) {
    die(`Get "https://localhost/api/v3/${endpoint}": dial tcp [::1]:443: connect: connection refused`, 1);
  }
  if (process.env["GH_REPLAY_COMPARE"] === undefined) unrecorded();
  const body = JSON.parse(readFileSync(process.env["GH_REPLAY_COMPARE"], "utf8"));
  const json = JSON.stringify(body);

  process.stdout.write(filter === undefined ? `${json}\n` : execFileSync("jq", ["-r", filter], { input: json, encoding: "utf8" }));
  process.exit(0);
}

/**
 * One response body, through `--jq` if one was passed. gh applies the filter to
 * each page *separately* under `--paginate` — which is why a count filter over
 * two pages prints two numbers — so this is called per page, and once for the
 * single array `--slurp` wraps them in.
 *
 * Raw output: gh prints string results unquoted, as standalone `jq -r` does.
 */
const emit = (body) => {
  const json = JSON.stringify(body);
  if (filter === undefined) {
    process.stdout.write(`${json}\n`);
    return;
  }
  try {
    process.stdout.write(execFileSync("jq", ["-r", filter], { input: json, encoding: "utf8" }));
  } catch {
    die("gh: failed to apply the jq filter", 1);
  }
};

/**
 * Which check-runs call this is, counted across processes in a file because
 * every invocation is its own process. The step composes this endpoint twice —
 * once per poll for the count, once for the listing — with byte-identical
 * argv, so *when* is the only thing that can tell them apart. Without that,
 * `GH_REPLAY_FAILURE` fails both together and "the count answered and the
 * listing did not" is not a scenario that can be written.
 */
const nthCheckRunsCall = () => {
  const file = process.env["GH_REPLAY_COUNTER"];

  if (file === undefined) return 1;

  const n = (existsSync(file) ? Number(readFileSync(file, "utf8")) : 0) + 1;

  writeFileSync(file, String(n));
  return n;
};

if (/\/commits\/[^/]+\/check-runs$/.test(endpoint)) {
  const failsFrom = Number(process.env["GH_REPLAY_FAILURE_AT"] ?? "1");
  const failure = nthCheckRunsCall() >= failsFrom ? process.env["GH_REPLAY_FAILURE"] : undefined;

  // A failed request under `--slurp` still writes JSON to **stdout**, and the
  // two shapes differ. Recorded 2026-09-19 against gh 2.100.0:
  //
  //   $ gh api repos/cli/cli/commits/000…/check-runs --paginate --slurp
  //   [{ "message": "Bad credentials", "documentation_url": …, "status": … }]
  //   gh: Bad credentials (HTTP 401)                           ← stderr, exit 1
  //
  //   $ gh api … --hostname localhost --paginate --slurp
  //   []
  //   Get "https://localhost/…": dial tcp [::1]:443: connect: …  ← stderr, exit 1
  //
  // That `[]` is why the count cannot be read off stdout: through the step's
  // filter it is a perfectly plausible zero. The 403 body is the shape the
  // first private adopter hit (docs/friction.md, 2026-09-17).
  if (failure !== undefined) {
    if (has("--slurp")) {
      process.stdout.write(
        failure === "403"
          ? `${JSON.stringify([
              {
                message: "Resource not accessible by integration",
                documentation_url: "https://docs.github.com/rest/checks/runs#list-check-runs-for-a-git-reference",
                status: "403",
              },
            ])}\n`
          : "[]",
      );
    }
    die(
      failure === "403"
        ? "gh: Resource not accessible by integration (HTTP 403)"
        : `Get "https://localhost/api/v3/${endpoint}": dial tcp [::1]:443: connect: connection refused`,
      1,
    );
  }

  if (!has("--paginate")) unrecorded();

  const pages = JSON.parse(readFileSync(process.env["GH_REPLAY_PAGES"] ?? "", "utf8"));

  // `--slurp` wraps every page into one outer array; without it the pages are
  // printed one after another, each its own JSON document.
  if (has("--slurp")) emit(pages);
  else for (const page of pages) emit(page);

  process.exit(0);
}

// The **combined status** endpoint, which is the other CI surface: a repository
// reporting through the status API has no check run to read at all.
//
// One body per page in the shape the endpoint documents —
// `{"state","sha","total_count","statuses":[{"context","state",…}]}` — and gh
// writes whatever the API returned through, so the only gh behaviour replayed
// here is the one already recorded above: `--slurp` wraps the pages in one
// outer array, and a bare `--paginate` prints them one after another.
//
// The default is a commit with no statuses on it at all, which is every
// repository whose CI is Actions and is what the scenarios about check runs
// want standing behind them.
if (/\/commits\/[^/]+\/status$/.test(endpoint)) {
  const failure = process.env["GH_REPLAY_STATUS_FAILURE"];

  // Same two shapes as the check-runs arm above, and for the same reason: a
  // failed request under `--slurp` still writes JSON to stdout, so the pipeline
  // the step builds succeeds at its first stage either way.
  if (failure !== undefined) {
    if (has("--slurp")) {
      process.stdout.write(
        failure === "403"
          ? `${JSON.stringify([
              {
                message: "Resource not accessible by integration",
                documentation_url: "https://docs.github.com/rest/commits/statuses",
                status: "403",
              },
            ])}\n`
          : "[]",
      );
    }
    die(
      failure === "403"
        ? "gh: Resource not accessible by integration (HTTP 403)"
        : `Get "https://localhost/api/v3/${endpoint}": dial tcp [::1]:443: connect: connection refused`,
      1,
    );
  }

  if (!has("--paginate")) unrecorded();

  const file = process.env["GH_REPLAY_STATUS_PAGES"];
  const pages = file === undefined ? [{ state: "success", total_count: 0, statuses: [] }] : JSON.parse(readFileSync(file, "utf8"));

  if (has("--slurp")) emit(pages);
  else for (const page of pages) emit(page);

  process.exit(0);
}

// The failure-log tail's two calls: the runs on the commit, then each one by
// id for its name. Both come from GH_REPLAY_RUNS, which is empty for every
// scenario that is not about the tail.
if (/\/actions\/runs\?/.test(endpoint)) {
  const failure = process.env["GH_REPLAY_RUNS_FAILURE"];

  // Without `--slurp`, an HTTP error's body still reaches **stdout**, and
  // unfiltered: `--jq` is not applied to it. Recorded 2026-09-29 against gh
  // 2.101.0, with `2>/dev/null` to keep the streams apart:
  //
  //   $ GH_TOKEN=bad gh api 'repos/cli/cli/actions/runs?head_sha=0000000&per_page=50' \
  //       --jq '.workflow_runs[] | .id' 2>/dev/null
  //   { "message": "Bad credentials", "documentation_url": …, "status": "401" }
  //   gh: Bad credentials (HTTP 401)                         ← stderr, exit 1
  //
  // A 403 takes the same path with its own message. An unreachable host writes
  // nothing to stdout — the `Get …: connection refused` line only, exit 1.
  //
  // Under `--slurp` the shapes are the check-runs arm's: the error body inside
  // the outer array, or `[]` for an unreachable host.
  if (failure !== undefined) {
    if (has("--slurp")) {
      process.stdout.write(
        failure === "403"
          ? `${JSON.stringify([
              {
                message: "Resource not accessible by integration",
                documentation_url: "https://docs.github.com/rest/actions/workflow-runs#list-workflow-runs-for-a-repository",
                status: "403",
              },
            ])}\n`
          : "[]",
      );
    } else if (failure === "403") {
      process.stdout.write(
        `${JSON.stringify(
          {
            message: "Resource not accessible by integration",
            documentation_url: "https://docs.github.com/rest/actions/workflow-runs#list-workflow-runs-for-a-repository",
            status: "403",
          },
          null,
          2,
        )}`,
      );
    }
    die(
      failure === "403"
        ? "gh: Resource not accessible by integration (HTTP 403)"
        : `Get "https://localhost/api/v3/${endpoint}": dial tcp [::1]:443: connect: connection refused`,
      1,
    );
  }

  const workflowRuns = runsThisCall();
  const body = { total_count: workflowRuns.length, workflow_runs: workflowRuns };

  // One page, which `--slurp` wraps like any other.
  emit(has("--slurp") ? [body] : body);
  process.exit(0);
}

// The PRD preflight's shape query, and the merge step's review threads —
// told apart by the query, which is the only thing that differs. The envelope
// is GraphQL's own; what is inside it is whatever the scenario says. The
// threads are one page, which `--slurp` wraps like any other.
if (endpoint === "graphql") {
  if (flags.some((flag) => flag.startsWith("query=") && flag.includes("reviewThreads"))) {
    const page = {
      data: {
        repository: {
          pullRequest: {
            reviewThreads: { pageInfo: { hasNextPage: false, endCursor: null }, nodes: fixture("GH_REPLAY_THREADS", []) },
          },
        },
      },
    };

    emit(has("--slurp") ? [page] : page);
    process.exit(0);
  }
  emit({ data: { repository: { issue: fixture("GH_REPLAY_ISSUE", null) } } });
  process.exit(0);
}

// The Actions policies (#238). The **list** carries each policy's id, name,
// enforcement, source and target and nothing of what it says: no `conditions`,
// no `rules`. Found 2026-09-30 against the live API, where `init`'s own policy
// listed as allowing nothing, and a replay serving full objects here is what
// let that ship. What a policy says comes from its own endpoint, and that is
// the **repository's** for a parent's policy too: GitHub's REST description
// (github/rest-api-description, "Get a repository Actions policy") gives an
// enterprise-sourced policy as that endpoint's example. Only the repository's
// endpoints are recorded, so a reader that went to `orgs/…` would not be served.
if (/^repos\/[^/]+\/[^/]+\/actions\/policies\?/.test(endpoint)) {
  const policies = fixture("GH_REPLAY_POLICIES", []).map(({ conditions: _c, rules: _r, ...listed }) => listed);

  emit({ total_count: policies.length, policies });
  process.exit(0);
}

const policyId = /^repos\/[^/]+\/[^/]+\/actions\/policies\/([0-9]+)$/.exec(endpoint);

if (policyId !== null) {
  const failing = (process.env["GH_REPLAY_POLICY_FAILURE"] ?? "").split(",");
  const policy = fixture("GH_REPLAY_POLICIES", []).find((candidate) => String(candidate.id) === policyId[1]);

  if (failing.includes(policyId[1])) die("gh: Resource not accessible by integration (HTTP 403)", 1);
  if (policy === undefined) die("gh: Not Found (HTTP 404)", 1);
  emit(policy);
  process.exit(0);
}

// The repository itself — the REST object, of which only the merge settings
// are ever read.
if (/^repos\/[^/]+\/[^/]+$/.test(endpoint)) {
